{
  "meta": {
    "name": "Aurel",
    "source": "art_direction.json",
    "mode": "light",
    "as_of": "2026-10-09"
  },
  "color": {
    "ground": { "$type": "color", "$value": "#F4F6FA", "role": "background", "$description": "Proposed ground from the art direction's palette candidates." },
    "surface": { "$type": "color", "$value": "#FFFFFF", "role": "background", "$description": "Cards and sheets." },
    "text": { "$type": "color", "$value": "#2F3442", "role": "text", "$description": "Deep warm grey anchor; 11.48:1 on ground." },
    "text-muted": { "$type": "color", "$value": "#5A6072", "role": "text", "$description": "Captions and metadata; still AA on ground." },
    "accent": { "$type": "color", "$value": "#8C84C7", "role": "fill", "$description": "The art direction's lavender. Decorative fills and illustration only: it cannot carry body text either way." },
    "accent-text": { "$type": "color", "$value": "#5B5299", "role": "text", "$description": "Derived: the accent darkened until it passes AA for links." },
    "action": { "$type": "color", "$value": "{color.accent-text}", "role": "fill", "$description": "Button fill. Reuses the derived accent so actions stay on-brand and readable." },
    "on-action": { "$type": "color", "$value": "#FFFFFF", "role": "text", "$description": "Button labels." },
    "border": { "$type": "color", "$value": "#D5DAE3", "role": "border", "$description": "Decorative dividers only; inputs need a 3:1 edge or a fill change." },
    "focus": { "$type": "color", "$value": "{color.accent-text}", "role": "border", "$description": "Focus ring." }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": ["ui-rounded", "system-ui", "sans-serif"], "$description": "Rounded sans per the art direction. Swap in a licensed family once chosen." },
    "body": { "$type": "fontFamily", "$value": ["ui-rounded", "system-ui", "sans-serif"] }
  },
  "font-size": {
    "caption": { "$type": "dimension", "$value": "14px" },
    "body": { "$type": "dimension", "$value": "17px", "$description": "Art direction: body at 16px or larger." },
    "title": { "$type": "dimension", "$value": "22px" },
    "display": { "$type": "dimension", "$value": "32px" }
  },
  "line-height": {
    "body": { "$type": "number", "$value": 1.5 },
    "tight": { "$type": "number", "$value": 1.2 }
  },
  "font-weight": {
    "regular": { "$type": "fontWeight", "$value": 400 },
    "medium": { "$type": "fontWeight", "$value": 500 }
  },
  "radius": {
    "control": { "$type": "dimension", "$value": "14px" },
    "card": { "$type": "dimension", "$value": "20px", "$description": "Art direction: 16–24px cards, never sharp." },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "16px" },
    "4": { "$type": "dimension", "$value": "24px" },
    "5": { "$type": "dimension", "$value": "40px" }
  },
  "duration": {
    "quick": { "$type": "duration", "$value": "200ms" },
    "settle": { "$type": "duration", "$value": "400ms", "$description": "Art direction: 300–500ms, settling." }
  },
  "easing": {
    "settle": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1], "$description": "Long ease-out, no overshoot." }
  },
  "contrast_pairs": [
    { "text": "{color.text}", "background": "{color.ground}", "min": 4.5, "use": "body text" },
    { "text": "{color.text}", "background": "{color.surface}", "min": 4.5, "use": "text on cards" },
    { "text": "{color.text-muted}", "background": "{color.ground}", "min": 4.5, "use": "captions" },
    { "text": "{color.accent-text}", "background": "{color.ground}", "min": 4.5, "use": "links" },
    { "text": "{color.on-action}", "background": "{color.action}", "min": 4.5, "use": "button labels" },
    { "text": "{color.focus}", "background": "{color.ground}", "min": 3, "use": "focus ring" },
    { "text": "{color.text}", "background": "{color.accent}", "min": 3, "use": "large headings on decorative fill only" }
  ],
  "assumptions": [
    "Light mode only; a dark set needs its own pass",
    "Font families are platform stacks until a licensed family is chosen"
  ]
}
