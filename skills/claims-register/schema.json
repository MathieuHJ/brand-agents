{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claims register",
  "type": "object",
  "required": ["product", "as_of", "owner", "claims", "banned", "unknowns"],
  "additionalProperties": false,
  "properties": {
    "product": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "owner": { "type": "string", "minLength": 1 },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "status", "source", "match"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^C[0-9]+$" },
          "statement": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["shipped", "beta", "planned", "proposed", "retired"] },
          "source": { "type": "string", "minLength": 1 },
          "match": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
          "approved_phrasings": { "type": "array", "items": { "type": "string" } },
          "overreach_phrasings": { "type": "array", "items": { "type": "string" } },
          "surfaces": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "banned": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phrase", "reason", "rewrite"],
        "additionalProperties": false,
        "properties": {
          "phrase": { "type": "string", "minLength": 2 },
          "reason": { "type": "string" },
          "rewrite": { "type": "string" }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "owner"],
        "additionalProperties": false,
        "properties": {
          "question": { "type": "string" },
          "owner": { "type": "string" }
        }
      }
    }
  }
}
