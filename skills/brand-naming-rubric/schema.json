{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brand naming shortlist",
  "type": "object",
  "required": ["idea", "assumptions", "top_10", "safe_5", "wildcard_5", "next_steps"],
  "additionalProperties": false,
  "properties": {
    "idea": { "type": "string", "minLength": 1 },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "architecture_recommendation": { "type": "string" },
    "top_10": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["name", "strategy", "pronunciation", "score_total", "scores", "rationale", "risks", "recommended_domain_checks"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "strategy": {
            "type": "string",
            "enum": ["invented", "compound", "metaphor", "real-word", "foreign-root", "altered-spelling", "initialism"]
          },
          "pronunciation": { "type": "string" },
          "score_total": { "type": "integer", "minimum": 5, "maximum": 25 },
          "scores": {
            "type": "object",
            "required": ["memorability", "pronounceability", "distinctiveness", "semantic_fit", "visual_potential"],
            "additionalProperties": false,
            "properties": {
              "memorability": { "type": "integer", "minimum": 1, "maximum": 5 },
              "pronounceability": { "type": "integer", "minimum": 1, "maximum": 5 },
              "distinctiveness": { "type": "integer", "minimum": 1, "maximum": 5 },
              "semantic_fit": { "type": "integer", "minimum": 1, "maximum": 5 },
              "visual_potential": { "type": "integer", "minimum": 1, "maximum": 5 }
            }
          },
          "rationale": { "type": "string" },
          "linguistic_notes": { "type": "array", "items": { "type": "string" } },
          "risks": { "type": "array", "items": { "type": "string" } },
          "recommended_domain_checks": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^\\.(?!edu$|gov$|mil$|int$)[a-z]{2,}$" }
          }
        }
      }
    },
    "safe_5": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "string" } },
    "wildcard_5": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "string" } },
    "filtered_out": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "reason"],
        "additionalProperties": false,
        "properties": { "name": { "type": "string" }, "reason": { "type": "string" } }
      }
    },
    "next_steps": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
