{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design tokens",
  "type": "object",
  "required": [
    "meta",
    "color",
    "contrast_pairs"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "name",
        "source",
        "mode",
        "as_of"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "light",
            "dark"
          ]
        },
        "as_of": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "$type",
          "$value",
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "$type": {
            "type": "string",
            "enum": [
              "color"
            ]
          },
          "$value": {
            "type": "string",
            "pattern": "^(#[0-9A-Fa-f]{6}|\\{color\\.[a-z0-9-]+\\})$"
          },
          "role": {
            "type": "string",
            "enum": [
              "background",
              "fill",
              "text",
              "border"
            ]
          },
          "$description": {
            "type": "string"
          }
        }
      }
    },
    "font": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "$type",
          "$value"
        ],
        "additionalProperties": false,
        "properties": {
          "$type": {
            "type": "string",
            "enum": [
              "fontFamily",
              "dimension",
              "number",
              "fontWeight",
              "duration",
              "cubicBezier"
            ]
          },
          "$value": {
            "type": [
              "string",
              "number",
              "array"
            ]
          },
          "$description": {
            "type": "string"
          }
        }
      }
    },
    "font-size": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "$type",
          "$value"
        ],
        "additionalProperties": false,
        "properties": {
          "$type": {
            "type": "string",
            "enum": [
              "fontFamily",
              "dimension",
              "number",
              "fontWeight",
              "duration",
              "cubicBezier"
            ]
          },
          "$value": {
            "type": [
              "string",
              "number",
              "array"
            ]
          },
          "$description": {
            "type": "string"
          }
        }
      }
    },
    "line-height": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "$type",
          "$value"
        ],
        "additionalProperties": false,
        "properties": {
          "$type": {
            "type": "string",
            "enum": [
              "fontFamily",
              "dimension",
              "number",
              "fontWeight",
              "duration",
              "cubicBezier"
            ]
          },
          "$value": {
            "type": [
              "string",
              "number",
              "array"
            ]
          },
          "$description": {
            "type": "string"
          }
        }
      }
    },
    "font-weight": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "$type",
          "$value"
        ],
        "additionalProperties": false,
        "properties": {
          "$type": {
            "type": "string",
            "enum": [
              "fontFamily",
              "dimension",
              "number",
              "fontWeight",
              "duration",
              "cubicBezier"
            ]
          },
          "$value": {
            "type": [
              "string",
              "number",
              "array"
            ]
          },
          "$description": {
            "type": "string"
          }
        }
      }
    },
    "radius": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "$type",
          "$value"
        ],
        "additionalProperties": false,
        "properties": {
          "$type": {
            "type": "string",
            "enum": [
              "fontFamily",
              "dimension",
              "number",
              "fontWeight",
              "duration",
              "cubicBezier"
            ]
          },
          "$value": {
            "type": [
              "string",
              "number",
              "array"
            ]
          },
          "$description": {
            "type": "string"
          }
        }
      }
    },
    "space": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "$type",
          "$value"
        ],
        "additionalProperties": false,
        "properties": {
          "$type": {
            "type": "string",
            "enum": [
              "fontFamily",
              "dimension",
              "number",
              "fontWeight",
              "duration",
              "cubicBezier"
            ]
          },
          "$value": {
            "type": [
              "string",
              "number",
              "array"
            ]
          },
          "$description": {
            "type": "string"
          }
        }
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "$type",
          "$value"
        ],
        "additionalProperties": false,
        "properties": {
          "$type": {
            "type": "string",
            "enum": [
              "fontFamily",
              "dimension",
              "number",
              "fontWeight",
              "duration",
              "cubicBezier"
            ]
          },
          "$value": {
            "type": [
              "string",
              "number",
              "array"
            ]
          },
          "$description": {
            "type": "string"
          }
        }
      }
    },
    "easing": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "$type",
          "$value"
        ],
        "additionalProperties": false,
        "properties": {
          "$type": {
            "type": "string",
            "enum": [
              "fontFamily",
              "dimension",
              "number",
              "fontWeight",
              "duration",
              "cubicBezier"
            ]
          },
          "$value": {
            "type": [
              "string",
              "number",
              "array"
            ]
          },
          "$description": {
            "type": "string"
          }
        }
      }
    },
    "contrast_pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "text",
          "background",
          "min",
          "use"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "pattern": "^\\{color\\.[a-z0-9-]+\\}$"
          },
          "background": {
            "type": "string",
            "pattern": "^\\{color\\.[a-z0-9-]+\\}$"
          },
          "min": {
            "type": "number",
            "minimum": 1,
            "maximum": 21
          },
          "use": {
            "type": "string"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
